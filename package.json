{
  "name": "studyspace",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "node scripts/expo.mjs start --web --port 8081",
    "android": "node scripts/build-native-apk.mjs --debug",
    "start": "node server/index.mjs",
    "build": "node scripts/expo.mjs export --platform web",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node --test tests/api.test.mjs tests/tenant-isolation.test.mjs",
    "test:android": "node scripts/build-native-apk.mjs --test",
    "apk": "node scripts/build-native-apk.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.1",
    "@expo-google-fonts/instrument-serif": "^0.4.0",
    "@expo/metro-runtime": "~55.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.32",
    "expo-constants": "~55.0.0",
    "expo-document-picker": "~55.0.0",
    "expo-file-system": "~55.0.0",
    "expo-font": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "expo-sharing": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "expo-system-ui": "~55.0.0",
    "expo-updates": "~55.0.33",
    "lucide-react-native": "^1.61.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
