PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3001
# Optional web build default (native uses STUDYSPACE_API_URL).
# EXPO_PUBLIC_API_URL=https://study.example.com
# STUDYSPACE_API_URL=https://study.example.com
# Vercel production sync uses PostgreSQL, not its ephemeral filesystem.
# DATABASE_URL=your-pooled-postgres-url
# DATABASE_URL_UNPOOLED=your-direct-postgres-url
# Never commit database URLs or APK signing keys.
